{
  "compilerOptions": {
    "composite": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "incremental": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "paths": {
      "@cherrystudio/ai-core": ["./packages/aiCore/src/index.ts"],
      "@cherrystudio/ai-core/*": ["./packages/aiCore/src/*"],
      "@cherrystudio/ai-core/built-in/plugins": ["./packages/aiCore/src/core/plugins/built-in/index.ts"],
      "@cherrystudio/ai-core/provider": ["./packages/aiCore/src/core/providers/index.ts"],
      "@cherrystudio/ai-sdk-provider": ["./packages/ai-sdk-provider/src/index.ts"],
      "@cherrystudio/provider-registry": ["./packages/provider-registry/src/index.ts"],
      "@cherrystudio/ui": ["./packages/ui/src/index.ts"],
      "@cherrystudio/ui/*": ["./packages/ui/src/*"],
      "@cherrystudio/ui/icons": ["./packages/ui/src/components/icons/index.ts"],
      "@data/*": ["./src/renderer/data/*"],
      "@logger": ["./src/renderer/services/LoggerService"],
      "@mcp-trace/*": ["./packages/mcp-trace/*"],
      "@renderer/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"],
      "@test-mocks/*": ["./tests/__mocks__/*"],
      "@cherrystudio/web-search": ["./packages/web-search/src/index.ts"],
      "@cherrystudio/web-search/catalog": ["./packages/web-search/src/catalog.ts"],
      "@cherrystudio/web-search/providers/zhipu": ["./packages/web-search/src/providers/zhipu.ts"],
      "@cherrystudio/web-search/providers/tavily": ["./packages/web-search/src/providers/tavily.ts"],
      "@cherrystudio/web-search/providers/searxng": ["./packages/web-search/src/providers/searxng.ts"],
      "@cherrystudio/web-search/providers/exa": ["./packages/web-search/src/providers/exa.ts"],
      "@cherrystudio/web-search/providers/exa-mcp": ["./packages/web-search/src/providers/exaMcp.ts"],
      "@cherrystudio/web-search/providers/bocha": ["./packages/web-search/src/providers/bocha.ts"],
      "@cherrystudio/web-search/providers/querit": ["./packages/web-search/src/providers/querit.ts"],
      "@cherrystudio/web-search/providers/jina": ["./packages/web-search/src/providers/jina.ts"],
      "@cherrystudio/web-search/providers/firecrawl": ["./packages/web-search/src/providers/firecrawl.ts"],
      "@cherrystudio/web-search/providers/crawl4ai": ["./packages/web-search/src/providers/crawl4ai.ts"],
      "@cherrystudio/web-search/providers/parallel": ["./packages/web-search/src/providers/parallel.ts"],
      "@cherrystudio/web-search/providers/serply": ["./packages/web-search/src/providers/serply.ts"],
      "@cherrystudio/web-search/providers/searchapi": ["./packages/web-search/src/providers/searchapi.ts"],
      "@cherrystudio/web-search/providers/yuanbao": ["./packages/web-search/src/providers/yuanbao.ts"],
      "@cherrystudio/web-search/providers/deepseek": ["./packages/web-search/src/providers/deepseek.ts"],
      "@cherrystudio/web-search/providers/desearch": ["./packages/web-search/src/providers/desearch.ts"],
      "@cherrystudio/web-search/tools/config": ["./packages/web-search/src/tools/config.ts"],
      "@cherrystudio/web-search/tools/url-filter": ["./packages/web-search/src/tools/urlFilter.ts"],
      "@cherrystudio/web-search/tools/content": ["./packages/web-search/src/tools/content.ts"]
    },
    "tsBuildInfoFile": ".tsbuildinfo/tsconfig.web.tsbuildinfo",
    "useDefineForClassFields": true
  },
  "exclude": ["packages/aiCore/src/**/__tests__/**"],
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "local/src/renderer/**/*",
    "src/renderer/**/*",
    "src/preload/*.d.ts",
    "tests/__mocks__/**/*",
    "packages/aiCore/src/**/*",
    "packages/ai-sdk-provider/**/*",
    "packages/mcp-trace/**/*",
    "packages/provider-registry/**/*",
    "src/shared/**/*",
    "packages/ui/**/*"
  ]
}
